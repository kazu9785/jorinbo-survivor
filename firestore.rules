rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidPlayerFields() {
      return request.resource.data.keys().hasOnly('isDeveloper,username,usernameKey,highestWave,latestWave,attempts,createdAt,updatedAt,boards'.split(','))
        && (!('boards' in request.resource.data) || validBoards(request.resource.data.boards))
        && (!('isDeveloper' in request.resource.data) || request.resource.data.isDeveloper is bool)
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 2
        && request.resource.data.username.size() <= 64
        && request.resource.data.usernameKey is string
        && request.resource.data.usernameKey.size() >= 2
        && request.resource.data.usernameKey.size() <= 64
        && request.resource.data.highestWave is int
        && request.resource.data.highestWave >= 0
        && request.resource.data.latestWave is int
        && request.resource.data.latestWave >= 0
        && request.resource.data.highestWave >= request.resource.data.latestWave
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 0
        && request.resource.data.attempts <= 1000000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isNewPlayer() {
      return request.resource.data.get('isDeveloper', false) == false
        && (!('boards' in request.resource.data) || request.resource.data.boards.hasOnly([0]))
        && request.resource.data.highestWave == 0
        && request.resource.data.latestWave == 0
        && request.resource.data.attempts == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isAttemptIncrement() {
      return request.resource.data.attempts == resource.data.attempts + 1
        && request.resource.data.highestWave == resource.data.highestWave
        && request.resource.data.latestWave == resource.data.latestWave;
    }

    function isWaveUpdate() {
      return request.resource.data.attempts == resource.data.attempts
        && request.resource.data.highestWave >= resource.data.highestWave;
    }

    function isFullReset() {
      return request.resource.data.highestWave == 0
        && request.resource.data.latestWave == 0
        && request.resource.data.attempts == 0;
    }

    match /players/{userId} {
      // ランキングはログイン前を含め、誰でも閲覧可能
      allow read: if true;

      // 自分のプレイヤーデータだけ作成・更新可能
      allow create: if signedInAs(userId)
        && hasValidPlayerFields()
        && isNewPlayer();
      allow update: if signedInAs(userId)
        && hasValidPlayerFields()
        && request.resource.data.get('isDeveloper', false) == resource.data.get('isDeveloper', false)
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameKey == resource.data.usernameKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (isAttemptIncrement() || isWaveUpdate() || isFullReset());

      // アカウント削除時は、ログイン中の本人だけ自分の記録を削除可能
      allow delete: if signedInAs(userId);
    }

    // 1.0.3: 評価式1,000回の上限を避けるため、型と範囲を分けて検証。
    // keys()および必須フィールドの直接参照は、型違い・欠落時に拒否される。
    function validCountValues(values) {
      return values.join(',').matches('^(0|[1-9][0-9]{0,8}|1000000000)(,(0|[1-9][0-9]{0,8}|1000000000))*$');
    }
    function validCodex(c) {
      return c is map && c.keys().hasOnly('minion,shooter,golem,rusher,treasure,boss_fire,boss_fire_phase2,boss_ice,boss_ice_phase2,boss_forest,boss_forest_phase2,boss_dark,boss_dark_phase2,goblin,bat,mushroom,skeleton,beetle,wolf,eye_mage,crystal_turtle,harpy,mech_spider,death_knight,manticore,reaper,treant,storm_drake,boss_thunder,boss_thunder_phase2,boss_sand,boss_sand_phase2,boss_abyss,boss_abyss_phase2,boss_moon,boss_moon_phase2,boss_phoenix,boss_phoenix_phase2,t1_01,t1_02,t1_03,t1_04,t1_05,t1_06,t1_07,t1_08,t1_09,t1_10,t1_11,t2_01,t2_02,t2_03,t2_04,t2_05,t2_06,t2_07,t2_08,t2_09,t2_10,t2_11,t3_01,t3_02,t3_03,t3_04,t3_05,t3_06,t3_07,t3_08,t3_09,t3_10,t3_11,t4_01,t4_02,t4_03,t4_04,t4_05,t4_06,t4_07,t4_08,t4_09,t4_10,t4_11,t5_01,t5_02,t5_03,t5_04,t5_05,t5_06,t5_07,t5_08,t5_09,t5_10,t5_11,boss_oni,boss_oni_phase2,boss_frostfox,boss_frostfox_phase2,boss_hydra,boss_hydra_phase2,boss_sunlion,boss_sunlion_phase2,boss_chronos,boss_chronos_phase2,boss_volcano,boss_volcano_phase2,boss_moth,boss_moth_phase2,boss_machine,boss_machine_phase2,boss_cosmos,boss_cosmos_phase2'.split(','))
        ;
    }
    // 数値列の文字列表現で一括検証。文字列の数値と区切り文字の混入は拒否。
    // 敵の種類が増えても評価式1,000回の上限に近づけない。
    function validCodexCounts(values) {
      let joined = values.join(',');
      let tokens = joined.split(',');
      return (values.size() == 0 || values.size() == tokens.size())
        && !values.hasAny(tokens)
        && joined.matches('^((0|[1-9][0-9]{0,8}|1000000000)(,(0|[1-9][0-9]{0,8}|1000000000))*)?$');
    }
    function validRecords(r) {
      return r.keys().hasOnly(['normal','endless'])
        && r.keys().hasAll(['normal','endless']);
    }
    function validResult(r) {
      return r == null || (r.keys().hasOnly('wave,coins,kills,bosses,seconds,character,mode,reason,newBest'.split(','))
        
        && r.coins is int && r.coins >= 0 && r.coins <= 9007199254740991
        && r.character in 'balance,power,speed,tank'.split(',')
        && r.mode in ['normal','endless','test']
        && r.reason is string && r.reason.size() <= 100 && r.newBest is bool);
    }
    function validTrainingLevels(l) {
      return l.keys().hasOnly(['a','b','c'])
        && l.a is int && l.b is int && l.c is int
        && l.values().hasOnly([0,1,2,3,4,5]);
    }
    function validCharacterTraining(p) {
      return p.keys().hasOnly('uses,bestWave,route,levels'.split(','))
        && p.uses is int && p.bestWave is int && validCountValues([p.uses,p.bestWave])
        && p.route in ['a','b','c'] && validTrainingLevels(p.levels);
    }
    function validTraining(t) {
      let b=t.balance; let p=t.power; let s=t.speed; let k=t.tank;
      let levels=b.levels.values().concat(p.levels.values()).concat(s.levels.values()).concat(k.levels.values());
      return t.keys().hasOnly('balance,power,speed,tank'.split(','))
        && b.keys().concat(p.keys()).concat(s.keys()).concat(k.keys()).hasOnly('uses,bestWave,route,levels'.split(','))
        && [b.route,p.route,s.route,k.route].hasOnly(['a','b','c'])
        && b.levels.keys().concat(p.levels.keys()).concat(s.levels.keys()).concat(k.levels.keys()).hasOnly(['a','b','c'])
        && levels.size()==12 && levels.hasOnly([0,1,2,3,4,5]);
    }
    // 検証対象を引数で渡し、深いフィールド参照の反復評価を避ける。
    // 型を個別に確認したうえで、数値範囲はネイティブの文字列照合で一括検証。
    // 許可範囲は従来と同じ 1〜1,000,000,000。
    function validLevelValues(values) {
      return values.join(',').matches('^([1-9][0-9]{0,8}|1000000000)(,([1-9][0-9]{0,8}|1000000000))*$');
    }
    function validUpgrades(u) {
      let fields='damage,fireRate,count,bulletSize,speed,maxHp'.split(',');
      let values=u.values();
      return u.keys().hasAll(fields) && u.keys().hasOnly(fields)
        && !values.hasAny([0]);
    }
    function validSkillLevels(l) {
      let fields='sphere,bomb,energy,satellite'.split(',');
      let values=l.values();
      return l.keys().hasAll(fields) && l.keys().hasOnly(fields)
        && !values.hasAny([0]);
    }
    function validSkills(sk) {
      return sk.keys().hasOnly(['owned','equipped','levels'])
        && sk.owned is list && sk.owned.size() >= 1 && sk.owned.size() <= 4
        && sk.owned.hasOnly('sphere,bomb,energy,satellite'.split(','))
        && sk.equipped in sk.owned && validSkillLevels(sk.levels);
    }
    function validEquipment(e) {
      let items=e.items; let equipped=e.equipped; let crystals=e.crystals; let nextId=e.nextId;
      let joined=items.join(';');
      return e.keys().hasOnly('version,crystals,nextId,items,equipped'.split(','))
        && e.version == 2 && crystals is int && crystals >= 0 && crystals <= 1000000000
        && nextId is int && nextId >= 1 && nextId <= 1000000000
        && items is list && items.size() <= 500 && items.toSet().size() == items.size()
        && joined.matches('^([1-9][0-9]{0,8}:([0-9]|1[0-5]):(1:([0-9]|[1-5][0-9]|60):([1-9]|1[0-2]):0:0|2:([0-9]|[1-8][0-9]|90):([1-9]|1[0-2]):0:0|3:([0-9]|[1-9][0-9]|1[0-2][0-9]|130):([1-9]|1[0-2]):([1-9]|1[0-2]):0|4:([0-9]|[1-9][0-9]|1[0-7][0-9]|180):([1-9]|1[0-2]):([1-9]|1[0-2]):0|5:([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|250):([1-9]|1[0-2]):([1-9]|1[0-2]):([1-9]|1[0-2]))(;[1-9][0-9]{0,8}:([0-9]|1[0-5]):(1:([0-9]|[1-5][0-9]|60):([1-9]|1[0-2]):0:0|2:([0-9]|[1-8][0-9]|90):([1-9]|1[0-2]):0:0|3:([0-9]|[1-9][0-9]|1[0-2][0-9]|130):([1-9]|1[0-2]):([1-9]|1[0-2]):0|4:([0-9]|[1-9][0-9]|1[0-7][0-9]|180):([1-9]|1[0-2]):([1-9]|1[0-2]):0|5:([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|250):([1-9]|1[0-2]):([1-9]|1[0-2]):([1-9]|1[0-2])))*)?$')
        && (items.size() == 0 || (joined.split(';').size() == items.size()
          && joined.replace(':[^;]+','').split(';').toSet().size() == items.size()))
        && equipped is list && equipped.size() == 16
        && equipped.hasOnly(items.concat(['none']))
        && equipped.join(',').matches('^(none|[1-9][0-9]{0,8}:0:[0-9:]+),(none|[1-9][0-9]{0,8}:1:[0-9:]+),(none|[1-9][0-9]{0,8}:2:[0-9:]+),(none|[1-9][0-9]{0,8}:3:[0-9:]+),(none|[1-9][0-9]{0,8}:4:[0-9:]+),(none|[1-9][0-9]{0,8}:5:[0-9:]+),(none|[1-9][0-9]{0,8}:6:[0-9:]+),(none|[1-9][0-9]{0,8}:7:[0-9:]+),(none|[1-9][0-9]{0,8}:8:[0-9:]+),(none|[1-9][0-9]{0,8}:9:[0-9:]+),(none|[1-9][0-9]{0,8}:10:[0-9:]+),(none|[1-9][0-9]{0,8}:11:[0-9:]+),(none|[1-9][0-9]{0,8}:12:[0-9:]+),(none|[1-9][0-9]{0,8}:13:[0-9:]+),(none|[1-9][0-9]{0,8}:14:[0-9:]+),(none|[1-9][0-9]{0,8}:15:[0-9:]+)$');
    }
    // Bounded compact format: materials#seen IDs#series assignments#12 named presets.
    function validForge(f) {
      return f is string && f.size()<=20000 && f.matches("^(0|[1-9][0-9]{0,8}|1000000000)#([1-9][0-9]{0,8}(,[1-9][0-9]{0,8}){0,499})?#([1-9][0-9]{0,8}:[0-7](,[1-9][0-9]{0,8}:[0-7]){0,499})?#([A-Za-z0-9%_.!~*'()-]{0,216}[|](0|[1-9][0-9]{0,8})(:(0|[1-9][0-9]{0,8})){3}:[abc]|)(;([A-Za-z0-9%_.!~*'()-]{0,216}[|](0|[1-9][0-9]{0,8})(:(0|[1-9][0-9]{0,8})){3}:[abc]|)){11}$");
    }
    function validBoards(b) {
      return b is list && b.size() == 42 && validCodexCounts(b);
    }
    function validJourney(j) {
      let locks=j.locks; let claimed=j.claimed; let tutorial=j.tutorial;
      return j is map && j.keys().hasOnly(['locks','claimed','tutorial'])
        && locks is list && locks.size() <= 500 && locks.toSet().size() == locks.size()
        && !locks.hasAny([0,1000000000])
        && claimed is list && claimed.size() <= 7 && claimed.toSet().size() == claimed.size()
        && claimed.hasOnly('boss,wave_balance,wave_power,wave_speed,wave_tank,codex10,codex25'.split(','))
        && tutorial is int && tutorial in [0,1,2];
    }
    function validCoreCounts(d) {
      let base=d.upgrade.values().concat(d.skills.levels.values());
      let t=d.get('training',null);
      let counts=t==null ? base : base.concat([t.balance.uses,t.balance.bestWave,t.power.uses,t.power.bestWave,t.speed.uses,t.speed.bestWave,t.tank.uses,t.tank.bestWave]);
      let locks=d.get('journey',{'locks':[]}).locks;
      let records=d.get('records',{'normal':0,'endless':0});
      let result=d.get('lastResult',null);
      let resultCounts=result==null?[]:[result.wave,result.kills,result.bosses,result.seconds];
      return validCodexCounts(counts.concat(locks).concat(d.get('codex',{}).values()).concat([records.normal,records.endless]).concat(resultCounts));
    }
    function validSaveData(d) {
      return d.keys().hasOnly('coins,endlessUnlocked,name,character,upgrade,skills,codex,records,lastResult,training,equipment,journey,forge'.split(','))
        && d.coins is int && d.coins >= 0 && d.coins <= 9007199254740991
        && d.endlessUnlocked is bool && d.name is string && d.name.size() <= 64
        && d.character in 'balance,power,speed,tank'.split(',')
        && validCoreCounts(d) && validUpgrades(d.upgrade) && validSkills(d.skills)
        && (!('forge' in d) || validForge(d.forge))
        && (!('journey' in d) || validJourney(d.journey))
        && (!('equipment' in d) || validEquipment(d.equipment))
        && (!('training' in d) || validTraining(d.training))
        && (!('codex' in d) || validCodex(d.codex))
        && (!('records' in d) || validRecords(d.records))
        && (!('lastResult' in d) || validResult(d.lastResult));
    }
    function validSaveDocument(doc) {
      return doc.keys().hasOnly(['data','revision','updatedAt'])
        && doc.revision is int && doc.revision >= 1
        && doc.updatedAt == request.time && validSaveData(doc.data);
    }
    function validSave() {
      return validSaveDocument(request.resource.data);
    }
    function developer(userId) {
      return get(/databases/$(database)/documents/players/$(userId)).data.get('isDeveloper', false) == true;
    }
    match /gameSaves/{userId} {
      allow read, delete: if signedInAs(userId);
      allow create: if signedInAs(userId) && request.resource.data.revision == 1 && validSave();
      allow update: if signedInAs(userId) && request.resource.data.revision == resource.data.revision + 1
        && validSave()
        && request.resource.data.data.keys().toSet().hasAll(resource.data.data.keys().toSet().intersection(['forge','journey','equipment','training'].toSet()));
    }
    match /developerSaves/{userId} {
      allow read: if signedInAs(userId) && developer(userId);
      allow delete: if signedInAs(userId);
      allow create: if signedInAs(userId) && request.resource.data.revision == 1 && developer(userId) && validSave();
      allow update: if signedInAs(userId) && request.resource.data.revision == resource.data.revision + 1
        && developer(userId) && validSave()
        && request.resource.data.data.keys().toSet().hasAll(resource.data.data.keys().toSet().intersection(['forge','journey','equipment','training'].toSet()));
    }

    // その他のデータはすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
